allow hal_bluetooth_default storage_device:chr_file { read write open ioctl };
#dontaudit hal_bluetooth_default self:udp_socket { create };
allow hal_bluetooth_default serial_device:chr_file rw_file_perms;
allow hal_bluetooth_default rtkbt_device:chr_file rw_file_perms;
allow hal_bluetooth_default sysfs:file write;
allow hal_bluetooth_default proc:file { open write };

# The platform deliberately forbids network sockets in HAL domains.  The
# legacy Realtek library's optional UDP diagnostic path therefore remains
# unavailable under enforcing mode; Bluetooth HCI itself uses the device node
# above and does not need this permission.

set_prop(hal_bluetooth_default, vendor_system_public_prop)
binder_call(hal_bluetooth_default, zygote)
