allow init zram_device:blk_file rw_file_perms;
allow init boot_block_device:lnk_file relabelto;
allow init uboot_block_device:blk_file relabelto;
allow init serial_device:chr_file rw_file_perms;

allow init sysfs_mmc:file rw_file_perms;
# Legacy Rockchip init scripts tune the eMMC queue and inspect ext_csd.
allow init debugfs_mmc:file { read open setattr };

# The BSP mounts tracefs through a directory already labeled as
# debugfs_tracing_debug.
allow init debugfs_tracing_debug:dir mounton;
